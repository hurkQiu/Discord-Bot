# 於 Discord Developer Portal 建立的 Bot Token
DISCORD_BOT_TOKEN=your_bot_token_here

# 指令前綴
COMMAND_PREFIX=!

# 允許下指令的文字頻道名稱（不含 #）
TEXT_CHANNEL_NAME=music

# 機器人加入播放音樂的語音頻道名稱
VOICE_CHANNEL_NAME=music

# 允許下小遊戲指令（數獨、踩地雷、熄燈、數織、猜成語）的文字頻道名稱（不含 #），與音樂頻道分開
GAME_CHANNEL_NAME=games

# yt-dlp 執行檔路徑，若已加入 PATH 可保持預設值
YTDLP_PATH=yt-dlp
